/*
 * ============================================================================
 *  MyLED.ino  ―  MyLED ライブラリの使い方サンプル
 * ============================================================================
 *  3個の LED を、タイマー割り込みで「同時に別々のパターン」で光らせます。
 *  loop() には何も書きません。点滅は裏側のタイマー割り込みが面倒を見るので、
 *  メインループを一切ブロックしないのがこのライブラリの特徴です。
 *
 *  配線（例）:
 *    ピン --[抵抗 220〜330Ω]-- LEDアノード(+) … LEDカソード(-) -- GND
 *
 *  ★使うピンの選び方★
 *    - 点滅(toggle) は好きな出力ピンでOK。
 *    - PWM(pwm) を使うピンだけ注意:
 *        AVR(UNO/Nano) … 3・5・6・11 番を使う（9・10番は点滅用Timer1と競合し不可）
 *        ESP32 系      … 出力可能な任意の GPIO でOK
 * ============================================================================
 */

#include "src/MyLED.h"

// LED を 3個ぶん用意する（配列）
LEDClass leds[3];

void setup() {
    // 1) 各 LED に使うピンを登録（出力に設定される）
    //    ↓のピン番号は自分の配線に合わせて変えてください
    leds[0].begin(2);   // 点滅用
    leds[1].begin(4);   // 点滅用
    leds[2].begin(11);  // PWM用（AVRではTimer1と競合しない11番を選択）

    // 2) 管理役 LED に「配列の先頭」と「個数」を渡す。ここで1msタイマーが起動する
    LED.begin(leds, 3);

    // 3) それぞれの光り方を指定
    LED[0].toggle(500); // 500ms ごとに点滅（ゆっくり）
    LED[1].toggle(200); // 200ms ごとに点滅（速い）
    LED[2].pwm(128);    // 明るさ 50%（0〜255 の中間）で点灯
}

void loop() {
    // 何も書かなくてOK。点滅はタイマー割り込みが自動で行うため、
    // ここで他の処理（センサ読み取りなど）に集中できます。
}
