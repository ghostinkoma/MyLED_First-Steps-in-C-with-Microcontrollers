/*
 * ============================================================================
 *  MyLED.ino  ―  MyLED 库使用示例
 * ============================================================================
 *  使用定时器中断同时控制 3 个 LED，使其以各自不同的模式发光。
 *  loop() 中无需编写任何代码。闪烁由后台的定时器中断全权处理，
 *  因此不会阻塞主循环，这也是本库的最大特点。
 *
 *  接线（示例）:
 *    引脚 --[电阻 220〜330Ω]-- LED正极(+) … LED负极(-) -- GND
 *
 *  ★ 引脚选择说明 ★
 *    - 闪烁(toggle) 可以使用任意输出引脚。
 *    - 使用 PWM(pwm) 的引脚需注意:
 *        AVR(UNO/Nano) … 请使用 3、5、6、11 号引脚（9、10号引脚因与闪烁用的Timer1冲突而无法使用）
 *        ESP32 系列    … 可以使用任意支持输出的 GPIO
 * ============================================================================
 */

#include "src/MyLED.h"

// 准备 3 个 LED 实例（数组）
LEDClass leds[3];

void setup() {
    // 1) 注册各个 LED 使用的引脚（会自动设置为输出模式）
    //    请根据您的实际接线修改下方引脚号
    leds[0].begin(2);   // 用于闪烁
    leds[1].begin(4);   // 用于闪烁
    leds[2].begin(11);  // 用于PWM（在AVR上选择与Timer1不冲突的11号引脚）

    // 2) 向管理类 LED 传入“数组首地址”和“数量”。此时 1ms 定时器将启动
    LED.begin(leds, 3);

    // 3) 分别指定发光模式
    LED[0].toggle(500); // 每 500ms 翻转一次（慢速闪烁）
    LED[1].toggle(200); // 每 200ms 翻转一次（快速闪烁）
    LED[2].pwm(128);    // 亮度 50%（0〜255 的中间值）常亮
}

void loop() {
    // 无需编写任何代码。闪烁将由定时器中断自动完成，
    // 因此您可以让此处专注于处理其他任务（如传感器读取等）。
}